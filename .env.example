# Signaling
PORT=4040

# robots-api (invite show/join). Empty → /invite-session returns 503.
ROBOTS_API_URL=http://127.0.0.1:3333

# CORS: * (LAN) ou origens separadas por vírgula em produção
CORS_ORIGIN=*

# --- ICE (coturn próprio — recomendado) ---
# Local: ../setup-turn-local.sh troca o host pelo IP da LAN (sync-telepresenca-env.sh).
# turns:...:443 é o caminho que passa em redes que só liberam a 443 (hospital, escola).
STUN_URLS=stun:turn.seudominio.com:3478,stun:stun.l.google.com:19302
TURN_URLS=turn:turn.seudominio.com:3478,turn:turn.seudominio.com:3478?transport=tcp,turns:turn.seudominio.com:443?transport=tcp
TURN_STATIC_AUTH_SECRET=
TURN_REALM=telepresenca.lan
TURN_USER_ID=telepresenca
# Validade da senha TURN em segundos. O robô só recebe a senha ao entrar na sala
# e pode esperar dias pelo operador, por isso a dele dura mais.
TURN_CREDENTIAL_TTL=86400
TURN_ROBOT_CREDENTIAL_TTL=604800
TURN_USERNAME=
TURN_CREDENTIAL=

# --- ICE (relay externo Metered — legado) ---
# Os robôs recusam o certificado TLS da Metered (Let's Encrypt): turns: não funciona neles.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
